# Moonshot AI API Key（用于翻译、词汇详情、对话等 AI 功能）
VITE_MOONSHOT_API_KEY=你的Moonshot密钥

# DeepL 服务端配置（用于 Vercel Function 代理，不要以 VITE_ 暴露到前端）
DEEPL_API_KEY=你的DeepL密钥
# 可选：强制指定 DeepL API 基础地址
# DEEPL_API_BASE=https://api-free.deepl.com

# 可选：桌面端 / 本地开发时指定 DeepL 代理基础地址
# 不填时，Web 端默认走当前站点，file:// / localhost 默认走 https://www.linswift.com
# VITE_DEEPL_PROXY_BASE_URL=https://www.linswift.com

# Supabase 配置（在 Supabase Dashboard 获取）
# 登录 https://supabase.com/ 创建项目后，在 Settings > API 中找到这些值
VITE_SUPABASE_URL=https://你的项目ID.supabase.co
VITE_SUPABASE_ANON_KEY=你的匿名密钥
