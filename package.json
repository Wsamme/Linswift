{
  "name": "linswift",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "prepare:icons": "node scripts/generate-icons.mjs",
    "prepare:ocr-assets": "node scripts/prepare-ocr-assets.mjs",
    "prepare:classic-books": "node scripts/prepare-classic-books.mjs",
    "seed:public-wordbooks": "node scripts/sync-public-wordbooks.mjs",
    "dev": "npm run prepare:icons && npm run prepare:ocr-assets && npm run prepare:classic-books && vite",
    "build": "npm run prepare:icons && npm run prepare:ocr-assets && npm run prepare:classic-books && tsc -b && vite build",
    "build:desktop": "npm run prepare:icons && npm run prepare:ocr-assets && npm run prepare:classic-books && tsc -b && BUILD_TARGET=desktop vite build",
    "desktop:start": "electron .",
    "desktop:start:dev": "ELECTRON_START_URL=http://localhost:5173 electron .",
    "desktop:build": "npm run build:desktop && electron-builder --mac dmg --publish never",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.20",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.563.0",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.1.18",
    "tesseract.js": "^7.0.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@playwright/mcp": "^0.0.68",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.1.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "pg": "^8.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2"
  },
  "build": {
    "appId": "com.linswift.desktop",
    "productName": "Linswift",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    }
  }
}
